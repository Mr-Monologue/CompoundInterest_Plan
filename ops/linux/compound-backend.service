[Unit]
Description=CompoundInterestPlan Backend
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/compound-interest-plan
ExecStart=/home/pi/compound-interest-plan/.venv/bin/python compoundctl.py start --mode backend-only
ExecStop=/home/pi/compound-interest-plan/.venv/bin/python compoundctl.py stop
Restart=on-failure
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=300

[Install]
WantedBy=multi-user.target
